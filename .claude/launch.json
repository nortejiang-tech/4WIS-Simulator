{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5174"],
      "cwd": "frontend",
      "port": 5174,
      "autoPort": false,
      "env": {
        "SIM4WIS_BACKEND_HTTP": "http://127.0.0.1:8012",
        "SIM4WIS_BACKEND_WS": "ws://127.0.0.1:8012"
      }
    }
  ]
}
